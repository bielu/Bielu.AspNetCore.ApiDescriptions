<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ByteBard AsyncAPI -->
    <PackageVersion Include="ByteBard.AsyncAPI.NET" Version="4.0.0-beta.21" />
    <PackageVersion Include="ByteBard.AsyncAPI.NET.Bindings" Version="4.0.0-beta.21" />
    <PackageVersion Include="ByteBard.AsyncAPI.NET.Readers" Version="4.0.0-beta.21" />
    <!-- Model Context Protocol (Bielu.AspNetCore.ApiDescriptions.Mcp) -->
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
    <!-- Wolverine (Bielu.AspNetCore.AsyncApi.Wolverine) -->
    <PackageVersion Include="WolverineFx" Version="6.41.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.41.0" />
    <PackageVersion Include="WolverineFx.SignalR" Version="6.41.0" />
    <PackageVersion Include="WolverineFx.Kafka" Version="6.41.0" />
    <!-- Arazzo spec library -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="JsonPath.Net" Version="3.0.2" />
    <PackageVersion Include="JsonPointer.Net" Version="7.0.2" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="System.Text.Json" Version="10.0.15" />
    <!-- Provides `dotnet getdocument`, used by src/examples/BuildTimeDocuments to write documents at build time. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <!-- Analyzer Testing -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.MSTest" Version="1.1.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <!-- Test frameworks -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.extensibility.core" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <!-- Playwright for headless browser testing -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
    <!-- Code Coverage -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- Aspire Hosting -->
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="13.4.6" />
    <!-- Starts real brokers (as Aspire resources) for integration tests that run the code under test in-process. -->
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Valkey" Version="13.4.6" />
    <!-- YARP -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Aspire Service Defaults -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!-- Aspire Client Integrations -->
    <PackageVersion Include="Aspire.Confluent.Kafka" Version="13.4.6" />
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.StackExchange.Redis" Version="13.4.6" />
    <PackageVersion Include="StackExchange.Redis" Version="3.0.17" />
    <!-- DI Decorator support -->
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <!-- Scalar API reference UI (AsyncAPI rendering) -->
    <!-- 2.16.17 / 0.11.12 are the first releases carrying `PluginUrls`, which the Aspire console
         packages use to register their plugin against the stock Scalar bundle. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.17" />
    <PackageVersion Include="Scalar.Aspire" Version="0.11.12" />
    <!-- Referenced directly by the projects that pull in Aspire.Hosting, to lift the MessagePack that
         StreamJsonRpc drags in (2.5.301/2.5.302) past GHSA-qhrr-8q5h-9q3h, patched in 2.5.303. Even the
         latest stable StreamJsonRpc (2.25.29) still depends on 2.5.302, and transitive pinning is
         disabled repo-wide, so a PackageVersion alone would not move it. Held on 2.x, the major
         StreamJsonRpc is built against. Drop once Aspire.Hosting ships a patched StreamJsonRpc. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <!-- API Versioning -->
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.0.0" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <!-- Kafka driver for the Scalar broker console. Held at the version Aspire.Confluent.Kafka
         13.4.6 depends on, so the Aspire mini-shop resolves one Confluent.Kafka, not two. -->
    <PackageVersion Include="Confluent.Kafka" Version="2.14.0" />
    <!-- gRPC (protocol bindings example + Scalar gRPC console) -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.80.0" />
    <PackageVersion Include="Grpc.AspNetCore.Web" Version="2.80.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
  </ItemGroup>
  <!--
    Packages released in lockstep with ASP.NET Core / the shared framework, so each target framework
    gets the line built for it. $(TargetFramework) is set in every inner build and in restore's
    per-framework evaluation, which is where package versions are resolved. Anything that is not a
    net11.0 build, including the netstandard2.0 analyzers and the single-target examples, takes the
    net10.0 line.
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <!-- Arazzo ASP.NET Core integration (OpenAPI self-wiring source) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <!-- Referenced directly, not just transitively through Microsoft.AspNetCore.OpenApi, to lift the
         Microsoft.OpenApi it drags in past GHSA-v5pm-xwqc-g5wc — a high-severity advisory covering
         >= 2.0.0-preview.11 through 2.7.4, patched in 2.7.5. Transitive pinning is disabled repo-wide,
         so a PackageVersion alone would not move it.

         Held at the floor `Microsoft.AspNetCore.OpenApi` itself declares: 10.0.15 depends on
         [2.13.0, 3.0.0), so anything lower is a downgrade (NU1605). Earlier 10.0.x releases' XML-comment
         source generator assigned `IOpenApiMediaType.Example`, which became read-only in 2.11.0; 10.0.15
         is built against 2.13 and no longer does. 3.x stays out of reach until the net10.0 package moves. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <!-- ASP.NET Core testing -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <!-- Microsoft.AspNetCore.OpenApi 11.0.0 depends on [3.11.0, 4.0.0); see the net10.0 entry for why
         it is referenced directly. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0" />
  </ItemGroup>
</Project>