<Project Sdk="Microsoft.NET.Sdk">

  <!-- The AppHost SDK brings Aspire's orchestrator (DCP), which DistributedApplicationTestingBuilder needs to
       start real resources such as the Kafka broker. Library references opt out of becoming Aspire project
       resources (IsAspireProjectResource="false") so they stay ordinary assembly references. -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.4.6" />

  <PropertyGroup>
    <TargetFrameworks>$(BieluTargetFrameworks)</TargetFrameworks>
    <!-- Aspire.AppHost.Sdk 13.4.6 picks the DCP/dashboard RID with the SDK's in-proc PickBestRid task,
         which is only registered in the per-framework inner builds; the multi-targeting outer build
         fails with MSB4036. Outside an inner build, take Aspire's own fallback (its out-of-proc RID tool). -->
    <_AspireUseSdkPickBestRid Condition="'$(TargetFramework)' == ''">false</_AspireUseSdkPickBestRid>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Kafka" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bielu.AspNetCore.AsyncApi.Scalar.Broker\Bielu.AspNetCore.AsyncApi.Scalar.Broker.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Bielu.AspNetCore.AsyncApi.Scalar.Broker.Kafka\Bielu.AspNetCore.AsyncApi.Scalar.Broker.Kafka.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Bielu.AspNetCore.AsyncApi.Scalar.Grpc.Aspire\Bielu.AspNetCore.AsyncApi.Scalar.Grpc.Aspire.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\..\src\Bielu.AspNetCore.AsyncApi.Scalar.SignalR.Aspire\Bielu.AspNetCore.AsyncApi.Scalar.SignalR.Aspire.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
