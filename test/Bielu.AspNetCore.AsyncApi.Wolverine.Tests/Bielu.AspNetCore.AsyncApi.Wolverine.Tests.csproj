<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BieluTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- BieluWolverinePackageVersion (set by scripts/verify-packages.sh consume-wolverine) tests the packed
       integration instead of the project, so one package can be checked against each WolverineFx version. -->
  <ItemGroup Condition="'$(BieluWolverinePackageVersion)' == ''">
    <ProjectReference Include="..\..\src\Bielu.AspNetCore.AsyncApi.Wolverine\Bielu.AspNetCore.AsyncApi.Wolverine.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(BieluWolverinePackageVersion)' != ''">
    <PackageReference Include="Bielu.AspNetCore.AsyncApi.Wolverine" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
    <PackageReference Include="WolverineFx.SignalR" />
    <PackageReference Include="WolverineFx.Kafka" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
