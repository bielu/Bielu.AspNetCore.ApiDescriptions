{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "src/examples/**",
            "src/Bielu.AspNetCore.AsyncApi.Templates/**",
            "src/Bielu.AspNetCore.AsyncApi.Analyzers/**",
            "src/Bielu.AspNetCore.AsyncApi.SourceGenerators/**",
            "src/Bielu.AspNetCore.AsyncApi/Microsoft.AspNetCore.OpenApi.csproj",
            "src/Bielu.AspNetCore.AsyncApi.ApiDescription.Server/**",
            "**/*.Tests/**",
            "**/*.Tests.*/**",
            "**/*.Test/**"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "public/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/**.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noIncrementalBuild": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_appName": "Bielu.AspNetCore.AsyncApi",
      "_appTitle": "Bielu.AspNetCore.AsyncApi",
      "_appLogoPath": "images/logo.svg",
      "_enableSearch": true,
      "_enableNewTab": true,
      "repository": "https://github.com/bielu/Bielu.AspNetCore.AsyncApi",
      "docurl": "https://github.com/bielu/Bielu.AspNetCore.AsyncApi/blob/main/docs"
    }
  }
}
