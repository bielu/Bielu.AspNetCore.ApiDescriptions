{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "src/examples/**",
            "src/Bielu.Arazzo/**",
            "src/Bielu.Arazzo.Readers/**",
            "src/Bielu.AspNetCore.AsyncApi.Templates/**",
            "src/Bielu.AspNetCore.AsyncApi.Analyzers/**",
            "src/Bielu.AspNetCore.AsyncApi.SourceGenerators/**",
            "src/Bielu.AspNetCore.AsyncApi/Microsoft.AspNetCore.OpenApi.csproj",
            "src/Bielu.AspNetCore.AsyncApi.ApiDescription.Server/**",
            "**/*.Tests/**",
            "**/*.Tests.*/**",
            "**/*.Test/**"
          ]
        }
      ],
      "dest": "api/asyncapi",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    },
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/Bielu.Arazzo/**/*.csproj",
            "src/Bielu.Arazzo.Readers/**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/*.Tests/**",
            "**/*.Tests.*/**",
            "**/*.Test/**"
          ]
        }
      ],
      "dest": "api/arazzo",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/asyncapi/**.yml",
          "api/asyncapi/index.md",
          "api/arazzo/**.yml",
          "api/arazzo/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "public/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/**.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noIncrementalBuild": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_appName": "Bielu API Descriptions",
      "_appTitle": "Bielu API Descriptions",
      "_appLogoPath": "images/logo.svg",
      "_enableSearch": true,
      "_enableNewTab": true,
      "repository": "https://github.com/bielu/Bielu.AspNetCore.ApiDescriptions",
      "docurl": "https://github.com/bielu/Bielu.AspNetCore.ApiDescriptions/blob/main/docs"
    }
  }
}
