<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Without this file the build inherits whatever feeds the machine happens to have configured, which
    is neither reproducible nor safe: every extra feed is another source that can answer for any
    package ID in Directory.Packages.props. It is also what produced 72 NU1507 warnings ("there are N
    package sources defined... please map your package sources"), one per project, on any machine with
    more than one feed.

    <clear /> drops the inherited feeds; everything this repository consumes comes from nuget.org.
    packageSourceMapping then states that explicitly, so adding a second feed later cannot silently
    start serving an existing package ID — it has to be mapped to the IDs it is allowed to answer for.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
