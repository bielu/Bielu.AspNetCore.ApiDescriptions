<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAspireHost>false</IsAspireHost>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Scalar.SignalR.Aspire</RootNamespace>
        <Description>Aspire hosting helper that adds the interactive SignalR console to a Scalar.Aspire API Reference resource by pointing it at the @bielu/scalar-signalr bundle.</Description>
        <PackageTags>scalar;signalr;asyncapi;aspire;api-reference</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Scalar.Aspire" />
    </ItemGroup>

    <!-- Generates the ScalarPluginBundleVersion constant from the npm package's version, so
         DefaultPluginUrl pins the @bielu/scalar-signalr version released from this commit. -->
    <PropertyGroup>
        <ScalarPluginPackageJsonPath>$(MSBuildProjectDirectory)/../Bielu.AspNetCore.AsyncApi.Scalar.SignalR/assets/package.json</ScalarPluginPackageJsonPath>
    </PropertyGroup>
    <Import Project="..\Bielu.AspNetCore.AsyncApi.Scalar\build\ScalarPluginBundleVersion.targets" />

</Project>
