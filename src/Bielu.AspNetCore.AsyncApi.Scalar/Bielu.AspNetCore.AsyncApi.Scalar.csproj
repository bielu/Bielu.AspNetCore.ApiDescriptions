<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Scalar</RootNamespace>
        <Description>Shared building blocks for the Bielu Scalar AsyncAPI console packages (SignalR, gRPC, ...): document options, embedded-bundle endpoint mapping and Scalar HeadContent injection. Referenced by the per-protocol packages; not useful on its own.</Description>
        <PackageTags>scalar;asyncapi;aspnetcore;api-reference</PackageTags>
        <DefaultItemExcludes>$(DefaultItemExcludes);assets/node_modules/**;assets/dist/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Scalar.AspNetCore" />
    </ItemGroup>

</Project>
