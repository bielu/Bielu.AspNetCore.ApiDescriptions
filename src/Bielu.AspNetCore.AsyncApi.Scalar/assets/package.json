{
  "name": "@bielu/scalar-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared internals for the Bielu Scalar AsyncAPI console plugins (document discovery, auth-state capture, schema examples, Scalar bootstrap). Consumed by the plugin packages via file: links and inlined into their IIFE bundles - never published.",
  "license": "MIT",
  "author": "Arkadiusz Biel",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./document-type": {
      "types": "./dist/document-type.d.ts",
      "default": "./dist/document-type.js"
    },
    "./vite": "./vite.mjs",
    "./tailwind.css": "./src/tailwind.css",
    "./document.css": "./src/document.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@scalar/themes": "0.20.2",
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "vue": "^3.5.13"
  },
  "peerDependenciesMeta": {
    "dompurify": {
      "optional": true
    },
    "marked": {
      "optional": true
    }
  }
}
