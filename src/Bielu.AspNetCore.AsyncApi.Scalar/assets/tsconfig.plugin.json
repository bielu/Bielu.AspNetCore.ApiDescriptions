{
  // The compiler options every document-type plugin package (`@bielu/scalar-arazzo`, `@bielu/scalar-likec4`) shares.
  // Path options (`baseUrl`, `paths`, `declarationDir`, `include`) resolve against the config that declares them,
  // so each package keeps those in its own tsconfig.json.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "emitDeclarationOnly": true
  }
}
