{
  "$schema": "http://json.schemastore.org/template",
  "author": "Arkadiusz Biel",
  "classifications": [ "Web", "AsyncAPI", "gRPC" ],
  "name": "ASP.NET Core gRPC Service with AsyncAPI",
  "identity": "Bielu.AspNetCore.AsyncApi.Templates.Grpc",
  "shortName": "asyncapi-grpc",
  "sourceName": "AsyncApiGrpc",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": "Target .NET 10 (LTS)"
        },
        {
          "choice": "net11.0",
          "description": "Target .NET 11 (STS)"
        }
      ],
      "replaces": "net10.0",
      "defaultValue": "net10.0"
    }
  }
}
