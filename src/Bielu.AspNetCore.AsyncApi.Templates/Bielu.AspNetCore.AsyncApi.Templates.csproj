<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <Description>dotnet new templates for Bielu.AspNetCore.AsyncApi: asyncapi-webapi, asyncapi-signalr, asyncapi-grpc, asyncapi-console and asyncapi-sln. Install with `dotnet new install Bielu.AspNetCore.AsyncApi.Templates` to scaffold an AsyncAPI-documented project, including the interactive Scalar consoles.</Description>
    <PackageTags>asyncapi;templates;dotnet-new;scaffolding;aspnetcore;signalr;grpc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*" Exclude="templates\**\bin\**;templates\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
