<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Avro</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <Description>Describes AsyncAPI message payloads as Apache Avro schemas (schemaFormat application/vnd.apache.avro), converted from the generated JSON Schemas, for Kafka and other Avro-based messaging.</Description>
        <PackageTags>asyncapi;avro;kafka;schema-registry;schemaformat;aspnetcore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi\Bielu.AspNetCore.AsyncApi.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Avro.Tests" />
    </ItemGroup>

</Project>
