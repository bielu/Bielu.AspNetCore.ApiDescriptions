<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Extensions.Protocols.Grpc</RootNamespace>
        <Description>gRPC protocol bindings for Bielu.AspNetCore.AsyncApi. Adds a custom "grpc" AsyncAPI protocol with channel, operation, message and server bindings.</Description>
        <PackageTags>asyncapi;grpc;bindings;protocol;aspnetcore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ByteBard.AsyncAPI.NET" />
      <PackageReference Include="ByteBard.AsyncAPI.NET.Bindings" />
      <PackageReference Include="ByteBard.AsyncAPI.NET.Readers" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi\Bielu.AspNetCore.AsyncApi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Extensions.Protocols.Grpc.Tests" />
    </ItemGroup>

</Project>
