{
  "name": "@bielu/scalar-arazzo",
  "version": "0.1.0",
  "private": true,
  "description": "Arazzo document type for the Scalar API Reference. Renders Arazzo workflows and steps, and resolves each step's target in the OpenAPI/AsyncAPI documents loaded next to it.",
  "license": "MIT",
  "author": "Arkadiusz Biel",
  "type": "module",
  "main": "./dist/plugin.js",
  "module": "./dist/plugin.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/plugin.js",
    "dist/scalar-plugin.mjs",
    "dist/types",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/plugin.js"
    },
    "./scalar-plugin.mjs": "./dist/scalar-plugin.mjs"
  },
  "keywords": [
    "scalar",
    "arazzo",
    "workflows",
    "openapi",
    "asyncapi",
    "api-reference",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bielu/Bielu.AspNetCore.ApiDescriptions"
  },
  "scripts": {
    "build:core": "cd ../../Bielu.AspNetCore.AsyncApi.Scalar/assets && npm run build",
    "prebuild": "npm run build:core",
    "build": "vite build && npm run build:module && vue-tsc -p tsconfig.json",
    "build:module": "vite build --config vite.config.module.ts",
    "pretypecheck": "npm run build:core",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@bielu/scalar-core": "file:../../Bielu.AspNetCore.AsyncApi.Scalar/assets",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.1.10"
  }
}
