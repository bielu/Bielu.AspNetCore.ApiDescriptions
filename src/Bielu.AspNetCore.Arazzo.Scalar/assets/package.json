{
  "name": "@bielu/scalar-arazzo",
  "version": "1.3.0",
  "description": "Arazzo document type for the Scalar API Reference. Renders Arazzo workflows and steps, and resolves each step's target in the OpenAPI/AsyncAPI documents loaded next to it.",
  "license": "MIT",
  "author": "Arkadiusz Biel",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/plugin.js",
  "jsdelivr": "./dist/plugin.js",
  "files": [
    "dist/index.mjs",
    "dist/plugin.js",
    "dist/scalar-plugin.mjs",
    "dist/types",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./plugin.js": "./dist/plugin.js",
    "./scalar-plugin.mjs": "./dist/scalar-plugin.mjs",
    "./package.json": "./package.json"
  },
  "keywords": [
    "scalar",
    "arazzo",
    "workflows",
    "openapi",
    "asyncapi",
    "api-reference",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bielu/Bielu.AspNetCore.ApiDescriptions"
  },
  "scripts": {
    "build:core": "cd ../../Bielu.AspNetCore.AsyncApi.Scalar/assets && npm run build",
    "prebuild": "npm run build:core",
    "build": "vite build && npm run build:module && npm run build:library && vue-tsc -p tsconfig.json",
    "build:module": "vite build --mode module",
    "pretypecheck": "npm run build:core",
    "typecheck": "vue-tsc --noEmit && vue-tsc -p tsconfig.contract.json",
    "pretest": "npm run build:core",
    "test": "vitest run",
    "dev": "vite build --watch",
    "build:library": "vite build --mode library",
    "postbuild": "node ../../Bielu.AspNetCore.AsyncApi.Scalar/assets/scripts/check-plugin-package.mjs createArazzoPlugin"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "dompurify": "^3.2.6",
    "marked": "^15.0.12",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@bielu/scalar-core": "file:../../Bielu.AspNetCore.AsyncApi.Scalar/assets",
    "@bielu/scalar-graph": "file:../../Bielu.AspNetCore.Scalar.Graph/assets",
    "@scalar/blocks": "0.7.3",
    "@scalar/components": "0.35.1",
    "@scalar/types": "^0.30.0",
    "@scalar/use-hooks": "0.4.27",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "~2.4.11",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "@vue/test-utils": {
      "minimatch": "^11.0.1"
    }
  }
}
