<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Merger</RootNamespace>
        <Description>Tool for merging multiple AsyncAPI documents into a single unified specification. Supports local and remote sources with caching and change detection.</Description>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="ByteBard.AsyncAPI.NET" />
        <PackageReference Include="ByteBard.AsyncAPI.NET.Bindings" />
        <PackageReference Include="ByteBard.AsyncAPI.NET.Readers" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Tests" />
        <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Cli" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi\Bielu.AspNetCore.AsyncApi.csproj" />
    </ItemGroup>

</Project>
