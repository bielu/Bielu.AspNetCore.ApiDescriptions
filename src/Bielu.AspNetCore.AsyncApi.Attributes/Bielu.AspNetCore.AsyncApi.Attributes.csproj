<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Description>The attributes used to describe AsyncAPI channels, operations, messages and parameters for Bielu.AspNetCore.AsyncApi. Split into its own dependency-free package so contract assemblies can be annotated without referencing ASP.NET Core. Ships the BASYNC Roslyn analyzers that catch attribute misuse at compile time.</Description>
        <PackageTags>asyncapi;attributes;annotations;analyzers;codefirst;api-description</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ByteBard.AsyncAPI.NET" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi.Analyzers\Bielu.AspNetCore.AsyncApi.Analyzers.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\Bielu.AspNetCore.AsyncApi.Analyzers\bin\$(Configuration)\netstandard2.0\Bielu.AspNetCore.AsyncApi.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

</Project>
