<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Cli</RootNamespace>
        <AssemblyName>Bielu.AspNetCore.AsyncApi.Cli</AssemblyName>

        <!-- .NET Tool packaging -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotnet-asyncapi</ToolCommandName>
        <PackageId>Bielu.AspNetCore.AsyncApi.Cli</PackageId>
        <Description>CLI tool for generating AsyncAPI documents at build time from ASP.NET Core applications.</Description>
        <PackageTags>asyncapi;cli;dotnet-tool;validate;diff;merge;documentation</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Cli.Tests" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi.Merger\Bielu.AspNetCore.AsyncApi.Merger.csproj" />
        <ProjectReference Include="..\Bielu.Cli.Shared\Bielu.Cli.Shared.csproj" />
    </ItemGroup>

</Project>
