<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- ByteBard.AsyncAPI is not annotated for trimming (it publishes IL2104/IL3053 of its own) and its
         serializers reach enum and array metadata reflectively, so the AOT build fails at runtime with
         "'ByteBard.AsyncAPI.Models.ReferenceType[]' is missing native code or metadata".

         Rooting the assembly is the right first step but is NOT sufficient on its own — the failure
         persists, because TrimmerRootAssembly governs the IL trimmer while native AOT decides
         reflection metadata separately. Kept because it is a prerequisite for any complete fix.
         Tracked as the open Native AOT item in LAUNCH-PREPARATION.md. -->
    <TrimmerRootAssembly Include="ByteBard.AsyncAPI" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" />
    <ProjectReference Include="..\..\Bielu.AspNetCore.AsyncApi\Bielu.AspNetCore.AsyncApi.csproj" />
    <!-- UndefineProperties: PublishAot flows down to referenced projects as a global property, and
         the generator targets netstandard2.0, which cannot be AOT-compiled (NETSDK1207). It is a
         build-time analyzer, so it must not inherit the publishing app's AOT settings. -->
    <ProjectReference Include="..\..\Bielu.AspNetCore.AsyncApi.SourceGenerators\Bielu.AspNetCore.AsyncApi.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" UndefineProperties="PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

</Project>
