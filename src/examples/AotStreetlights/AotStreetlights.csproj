<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" />
    <ProjectReference Include="..\..\Bielu.AspNetCore.AsyncApi\Bielu.AspNetCore.AsyncApi.csproj" />
    <!-- UndefineProperties: PublishAot flows down to referenced projects as a global property, and
         the generator targets netstandard2.0, which cannot be AOT-compiled (NETSDK1207). It is a
         build-time analyzer, so it must not inherit the publishing app's AOT settings. -->
    <ProjectReference Include="..\..\Bielu.AspNetCore.AsyncApi.SourceGenerators\Bielu.AspNetCore.AsyncApi.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" UndefineProperties="PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <!-- This example is the CI verification for the Native AOT path, so it uses the same targets and
       rd.xml file that get packed rather than a local copy of them: a regression in their *content*
       fails `scripts/verify-aot.sh`.

       What this does NOT cover is the packaging itself — a ProjectReference does not flow
       buildTransitive assets, so the file is imported by hand, and a wrong PackagePath would still
       pass here. (Pack does catch the narrower case of a misnamed targets file, via NU5129.) Closing
       that gap means packing the core project and consuming it through a PackageReference against a
       local feed, which is a change to this fixture and to verify-aot.sh, not just to this line. -->
  <Import Project="..\..\Bielu.AspNetCore.AsyncApi\build\Bielu.AspNetCore.AsyncApi.targets" />

</Project>
