<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Writes the OpenAPI, AsyncAPI and Arazzo documents at build time through Microsoft.Extensions.ApiDescription.Server's
    `dotnet getdocument`. That package generates on every build by default, so this example switches it off: building
    the solution should not boot the app. scripts/verify-build-time-documents.sh turns it on with
    -p:VerifyBuildTimeDocuments=true and checks the files that come out.
  -->
  <PropertyGroup Condition="'$(VerifyBuildTimeDocuments)' != 'true'">
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Bielu.AspNetCore.AsyncApi\Bielu.AspNetCore.AsyncApi.csproj" />
    <ProjectReference Include="..\..\Bielu.AspNetCore.Arazzo\Bielu.AspNetCore.Arazzo.csproj" />
  </ItemGroup>

</Project>
