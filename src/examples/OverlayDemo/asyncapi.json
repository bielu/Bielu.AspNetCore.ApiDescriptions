{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Streetlights",
    "version": "1.0.0"
  },
  "servers": {
    "production": {
      "host": "mqtt.example.com",
      "protocol": "mqtt"
    },
    "staging": {
      "host": "mqtt.staging.internal",
      "protocol": "mqtt"
    }
  },
  "channels": {
    "lightMeasured": {
      "address": "light/measured",
      "messages": {
        "lightMeasured": {
          "payload": {
            "type": "object",
            "properties": {
              "lumens": { "type": "integer" },
              "sentAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "internalDebug": {
      "address": "internal/debug",
      "messages": {
        "debugTrace": {
          "payload": { "type": "object" }
        }
      }
    }
  },
  "operations": {
    "receiveLightMeasurement": {
      "action": "receive",
      "channel": { "$ref": "#/channels/lightMeasured" }
    },
    "receiveInternalDebug": {
      "action": "receive",
      "channel": { "$ref": "#/channels/internalDebug" }
    }
  }
}
