<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Extensions.Protocols.Sse</RootNamespace>
        <Description>Server-Sent Events (SSE) protocol bindings for Bielu.AspNetCore.AsyncApi. Adds a custom "sse" AsyncAPI protocol with channel, operation, message and server bindings.</Description>
        <PackageTags>asyncapi;sse;server-sent-events;bindings;protocol;aspnetcore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ByteBard.AsyncAPI.NET" />
      <PackageReference Include="ByteBard.AsyncAPI.NET.Bindings" />
      <PackageReference Include="ByteBard.AsyncAPI.NET.Readers" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi\Bielu.AspNetCore.AsyncApi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Extensions.Protocols.Sse.Tests" />
    </ItemGroup>

</Project>
