<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAspireHost>false</IsAspireHost>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Scalar.Grpc.Aspire</RootNamespace>
        <Description>Aspire hosting helper that adds the interactive gRPC console to a Scalar.Aspire API Reference resource by pointing it at the @bielu/scalar-grpc bundle.</Description>
        <PackageTags>scalar;grpc;grpc-web;asyncapi;aspire;api-reference</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Scalar.Aspire" />
    </ItemGroup>

    <!-- Generates the ScalarPluginBundleVersion constant from the npm package's version, so
         DefaultBundleUrl pins the @bielu/scalar-grpc version released from this commit. -->
    <PropertyGroup>
        <ScalarPluginPackageJsonPath>$(MSBuildProjectDirectory)/../Bielu.AspNetCore.AsyncApi.Scalar.Grpc/assets/package.json</ScalarPluginPackageJsonPath>
    </PropertyGroup>
    <Import Project="..\Bielu.AspNetCore.AsyncApi.Scalar\build\ScalarPluginBundleVersion.targets" />

</Project>
