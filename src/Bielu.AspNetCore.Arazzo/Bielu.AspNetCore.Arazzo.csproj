<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bielu.AspNetCore.Arazzo</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <Description>ASP.NET Core integration for Bielu.Arazzo.NET: fluent workflow authoring, MapArazzo() document serving, and self-wiring source-description resolution against an app's own live AsyncAPI/OpenAPI documents.</Description>
        <PackageTags>arazzo;openapi;workflows;aspnetcore;api-description</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
      <PackageReference Include="Microsoft.OpenApi" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Bielu.Arazzo\Bielu.Arazzo.csproj" />
      <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi\Bielu.AspNetCore.AsyncApi.csproj" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Bielu.AspNetCore.Arazzo.Tests" />
    </ItemGroup>

    <!-- Ship the BARAZZO analyzers in this package, so every app that calls AddArazzo gets them. -->
    <ItemGroup>
        <ProjectReference Include="..\Bielu.AspNetCore.Arazzo.Analyzers\Bielu.AspNetCore.Arazzo.Analyzers.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Ask the analyzer project for its output path rather than assuming bin\, so packing with an artifacts
         layout (UseArtifactsOutput or the artifacts-path option of dotnet pack) picks up the DLL this build produced. -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddArazzoAnalyzerToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="_AddArazzoAnalyzerToPackage">
        <MSBuild Projects="..\Bielu.AspNetCore.Arazzo.Analyzers\Bielu.AspNetCore.Arazzo.Analyzers.csproj" Targets="GetTargetPath" RemoveProperties="TargetFramework;RuntimeIdentifier">
            <Output TaskParameter="TargetOutputs" ItemName="_ArazzoAnalyzerAssembly" />
        </MSBuild>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_ArazzoAnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
        </ItemGroup>
    </Target>

</Project>
