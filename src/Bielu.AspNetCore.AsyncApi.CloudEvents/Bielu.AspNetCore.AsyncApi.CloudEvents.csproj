<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.CloudEvents</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
        <Description>Describes AsyncAPI messages as CloudEvents 1.0: binary-mode ce-* headers per protocol binding (HTTP, Kafka, AMQP, MQTT), or the structured-mode application/cloudevents+json envelope around the payload.</Description>
        <PackageTags>asyncapi;cloudevents;cncf;events;messaging;aspnetcore</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi\Bielu.AspNetCore.AsyncApi.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.CloudEvents.Tests" />
    </ItemGroup>

</Project>
