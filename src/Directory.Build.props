<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
    <Import Project="../version.props"/>

    <PropertyGroup>
      <Title>$(MSBuildProjectName)</Title>
      <AssemblyName>$(MSBuildProjectName)</AssemblyName>
      <AssemblyVersion>$(Version)</AssemblyVersion>
      <GenerateDocumentationFile>true</GenerateDocumentationFile>
      <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Arkadiusz Biel</Authors>
        <PackageOutputPath>$(MSBuildProjectDirectory)/../../dist</PackageOutputPath>
        <PackageIcon>logo.png</PackageIcon>
        <!-- Inherited by every package. Package metadata is immutable once a version is published,
             so this has to be right before the first stable tag. -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <!-- Static, not $([System.DateTime]::UtcNow.Year): a build must not produce different
             package metadata depending on when it runs, and this has to match LICENSE. -->
        <Copyright>Copyright (c) 2025 Arkadiusz Biel</Copyright>
        <RepositoryUrl>https://github.com/bielu/Bielu.AspNetCore.ApiDescriptions</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://apidescriptions.bielu.pl/</PackageProjectUrl>
    </PropertyGroup>

    <!--
      Each package ships its own PACKAGE.md as its nuget.org landing page. Packing the root README
      into all of them instead — as this did until the 1.0 prep — put the AsyncAPI pitch and
      quickstart on the Arazzo, Overlay and CLI packages, which is simply the wrong page for them.

      The fallback to the root README keeps a new project packable before someone writes its
      PACKAGE.md; without it, `dotnet pack` would fail with NU5039 on a file that does not exist yet.
    -->
    <Choose>
        <When Condition="Exists('$(MSBuildProjectDirectory)/PACKAGE.md')">
            <PropertyGroup>
                <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
            </PropertyGroup>
            <ItemGroup>
                <None Include="$(MSBuildProjectDirectory)/PACKAGE.md" Pack="true" PackagePath="/" />
            </ItemGroup>
        </When>
        <Otherwise>
            <PropertyGroup>
                <PackageReadmeFile>README.md</PackageReadmeFile>
            </PropertyGroup>
            <ItemGroup>
                <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" />
            </ItemGroup>
        </Otherwise>
    </Choose>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../assets/logo.png" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!--
      License evidence inside the package, for ClearlyDefined (clearlydefined.io). Its licensed score
      counts the share of a package's files in which ScanCode finds both a license and a copyright
      notice. The nuspec already has both; these give the same to the files we produce:
        - LICENSE at the package root (the full MIT text with the copyright line);
        - an SPDX identifier in every assembly, next to the AssemblyCopyright from <Copyright> above;
        - a comment in the XML documentation file (_StampLicenseOnDocumentationFile below).
      The PACKAGE.md files carry a copyright line in their license paragraph for the same reason.
      NuGet's own files ([Content_Types].xml, .rels, .psmdcp, the signature) cannot carry one.
    -->
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" Visible="false" />
        <AssemblyMetadata Include="License" Value="SPDX-License-Identifier: MIT" />
    </ItemGroup>

    <Target Name="_StampLicenseOnDocumentationFile"
            AfterTargets="CoreCompile"
            Condition="'$(GenerateDocumentationFile)' == 'true' and '@(DocFileItem)' != '' and Exists('@(DocFileItem)')">
        <PropertyGroup>
            <_LicenseStamp>&lt;!-- $(Copyright). SPDX-License-Identifier: MIT --&gt;</_LicenseStamp>
            <_DocFilePath>@(DocFileItem->'%(FullPath)')</_DocFilePath>
            <_DocFileText>$([System.IO.File]::ReadAllText('$(_DocFilePath)'))</_DocFileText>
        </PropertyGroup>
        <!-- CoreCompile skips an up-to-date build, so the file can already be stamped. -->
        <WriteLinesToFile Condition="!$(_DocFileText.Contains('SPDX-License-Identifier'))"
                          File="@(DocFileItem)"
                          Lines="$([MSBuild]::Escape($(_DocFileText.Replace('&lt;doc&gt;', '&lt;doc&gt;$(_LicenseStamp)').TrimEnd())))"
                          Overwrite="true" />
    </Target>

    <!--
      Public API tracking is opt-in per project: adding PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt
      next to the csproj turns it on. A public member missing from those files (RS0016), or listed there
      but gone from the code (RS0017), then fails the build instead of only warning, so a change to the
      public surface cannot merge unrecorded. scripts/ship-public-api.mjs moves Unshipped to Shipped
      when a stable version is released.
    -->
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')">
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
