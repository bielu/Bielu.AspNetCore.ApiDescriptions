<Project>

  <!--
    MSBuild targets for Bielu.AspNetCore.AsyncApi.ApiDescription.Server.
    Generates AsyncAPI documents at build time by invoking the target application
    and resolving the IDocumentProvider service.

    This works by using Microsoft.Extensions.ApiDescription.Server's `dotnet getdocument`
    tool or our own Bielu.AspNetCore.AsyncApi.Cli tool to boot the application,
    discover registered AsyncAPI documents, and write them to disk.

    To use with Microsoft.Extensions.ApiDescription.Server (recommended):
    1. Add PackageReference to Microsoft.Extensions.ApiDescription.Server
    2. Add PackageReference to Bielu.AspNetCore.AsyncApi.ApiDescription.Server
    3. Configure properties in your .csproj (see .props file for available options)

    To use standalone with dotnet asyncapi CLI tool:
    1. Install the dotnet asyncapi tool: dotnet tool install -g Bielu.AspNetCore.AsyncApi.Cli
    2. Add PackageReference to Bielu.AspNetCore.AsyncApi.ApiDescription.Server
    3. The target below will invoke the CLI tool after build
  -->

  <!--
    Runs once per concrete framework build. NuGet imports build/ only into a project's per-framework
    inner builds, never the multi-targeting outer build, and the conditions below make that explicit.
    Design-time builds (IDE) skip it: they must not boot the application.
  -->
  <Target
    Name="GenerateAsyncApiDocuments"
    AfterTargets="Build"
    Condition="'$(AsyncApiGenerateDocumentsOnBuild)' == 'true' and '$(TargetFramework)' != '' and '$(IsCrossTargetingBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'"
    DependsOnTargets="Build">

    <PropertyGroup>
      <!-- The .props default is $(OutputPath), but package props are imported before the SDK sets
           OutputPath, so resolve the default here, where OutputPath is final. -->
      <_AsyncApiDocumentsDirectory>$(AsyncApiDocumentsDirectory)</_AsyncApiDocumentsDirectory>
      <_AsyncApiDocumentsDirectory Condition="'$(_AsyncApiDocumentsDirectory)' == ''">$(OutputPath)</_AsyncApiDocumentsDirectory>
      <_AsyncApiOutputDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(_AsyncApiDocumentsDirectory)'))</_AsyncApiOutputDir>
      <!-- A project with several target frameworks runs this once per framework. The default directory,
           $(OutputPath), is already per framework; a custom one is shared, so each framework writes to
           its own subfolder there instead of overwriting the others. Single-target projects keep the
           directory exactly as configured. Set AsyncApiDocumentsPerTargetFramework=false to opt out. -->
      <_AsyncApiOutputDir Condition="'$(TargetFrameworks)' != '' and '$(AsyncApiDocumentsPerTargetFramework)' != 'false' and '$(_AsyncApiOutputDir)' != '$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(OutputPath)))'">$([MSBuild]::NormalizeDirectory('$(_AsyncApiOutputDir)', '$(TargetFramework)'))</_AsyncApiOutputDir>
      <!-- NormalizeDirectory ends with a separator; drop it, or the closing quote of "dir\" is read as
           an escaped quote on Windows. -->
      <_AsyncApiOutputDir>$(_AsyncApiOutputDir.TrimEnd('\').TrimEnd('/'))</_AsyncApiOutputDir>
      <_AsyncApiAssemblyName>$(AssemblyName)</_AsyncApiAssemblyName>
      <!-- Absolute: the tool runs with OutputPath as its working directory, where a relative
           OutputPath-based path would point one OutputPath too deep. -->
      <_AsyncApiAssemblyPath>$(TargetPath)</_AsyncApiAssemblyPath>
      <_AsyncApiProjectName>$(MSBuildProjectName)</_AsyncApiProjectName>
      <!-- Absolute for the same reason as the assembly path: IntermediateOutputPath is relative to the
           project directory, not to OutputPath. -->
      <_AsyncApiFileListPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'asyncapi-documents.cache'))</_AsyncApiFileListPath>
    </PropertyGroup>

    <!-- Build the dotnet-getdocument arguments -->
    <PropertyGroup>
      <_AsyncApiToolArgs>getdocument --assembly "$(_AsyncApiAssemblyName)" --assembly-path "$(_AsyncApiAssemblyPath)" --output "$(_AsyncApiOutputDir)" --project "$(_AsyncApiProjectName)" --file-list "$(_AsyncApiFileListPath)"</_AsyncApiToolArgs>
      <_AsyncApiToolArgs Condition="'$(AsyncApiDocumentName)' != ''">$(_AsyncApiToolArgs) --document "$(AsyncApiDocumentName)"</_AsyncApiToolArgs>
      <_AsyncApiToolArgs Condition="'$(AsyncApiFileName)' != ''">$(_AsyncApiToolArgs) --file-name "$(AsyncApiFileName)"</_AsyncApiToolArgs>
    </PropertyGroup>

    <Message Text="Generating AsyncAPI documents..." Importance="high" />
    <Message Text="Output directory: $(_AsyncApiOutputDir)" Importance="normal" />

    <!-- Try to invoke the dotnet asyncapi tool -->
    <Exec
      Command="dotnet asyncapi $(_AsyncApiToolArgs)"
      WorkingDirectory="$(OutputPath)"
      IgnoreExitCode="false"
      ConsoleToMSBuild="true"
      ContinueOnError="ErrorAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="_AsyncApiExitCode" />
    </Exec>

    <Message
      Condition="'$(_AsyncApiExitCode)' == '0'"
      Text="AsyncAPI document generation completed successfully."
      Importance="high" />

    <Warning
      Condition="'$(_AsyncApiExitCode)' != '0'"
      Text="AsyncAPI document generation failed with exit code $(_AsyncApiExitCode). Ensure the dotnet asyncapi tool is installed: dotnet tool install -g Bielu.AspNetCore.AsyncApi.Cli" />

  </Target>

</Project>
