<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId>Bielu.Arazzo.NET.Readers</PackageId>
        <AssemblyName>Bielu.Arazzo.Readers</AssemblyName>
        <RootNamespace>Bielu.Arazzo.Readers</RootNamespace>
        <Description>JSON and YAML readers for the Arazzo Specification (OpenAPI workflows), producing Bielu.Arazzo.NET documents with diagnostics.</Description>
        <PackageTags>arazzo;openapi;workflows;yaml;json;parser;api-description</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="YamlDotNet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bielu.Arazzo\Bielu.Arazzo.csproj" />
        <ProjectReference Include="..\Bielu.Spec.Shared\Bielu.Spec.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bielu.Arazzo.Tests" />
    </ItemGroup>

</Project>
