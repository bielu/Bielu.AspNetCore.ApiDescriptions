{
  "name": "@bielu/scalar-signalr",
  "version": "0.1.0",
  "description": "Interactive SignalR console plugin for the Scalar API Reference. Reads SignalR AsyncAPI bindings and lets you connect to hubs, invoke methods and subscribe to server events.",
  "license": "MIT",
  "author": "Arkadiusz Biel",
  "type": "module",
  "main": "./dist/plugin.js",
  "module": "./dist/plugin.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "keywords": [
    "scalar",
    "signalr",
    "asyncapi",
    "api-reference",
    "plugin",
    "websocket"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bielu/Bielu.AspNetCore.AsyncApi"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
