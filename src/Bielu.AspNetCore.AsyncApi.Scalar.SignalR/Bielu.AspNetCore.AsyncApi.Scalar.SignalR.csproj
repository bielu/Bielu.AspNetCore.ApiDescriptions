<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Scalar.SignalR</RootNamespace>
        <Description>Interactive SignalR console for the Scalar API Reference in ASP.NET Core. Serves a Scalar bundle that adds a SignalR client driven by your SignalR AsyncAPI bindings.</Description>
        <PackageTags>scalar;signalr;asyncapi;aspnetcore;api-reference</PackageTags>
        <SignalRBundlePath>$(MSBuildProjectDirectory)/assets/dist/plugin.js</SignalRBundlePath>
        <DefaultItemExcludes>$(DefaultItemExcludes);assets/node_modules/**;assets/dist/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Scalar.AspNetCore" />
    </ItemGroup>

    <!-- The frontend sources whose changes must regenerate the embedded bundle. -->
    <ItemGroup>
        <SignalRAssetSource Include="$(MSBuildProjectDirectory)/assets/src/**/*" />
        <SignalRAssetSource Include="$(MSBuildProjectDirectory)/assets/package.json" />
        <SignalRAssetSource Include="$(MSBuildProjectDirectory)/assets/package-lock.json" />
        <SignalRAssetSource Include="$(MSBuildProjectDirectory)/assets/vite.config.ts" />
        <SignalRAssetSource Include="$(MSBuildProjectDirectory)/assets/tsconfig.json" />
    </ItemGroup>

    <!--
      The interactive client lives in the assets/ npm package (@bielu/scalar-signalr). Rebuild the
      single IIFE bundle whenever the plugin source or build config changes (incremental via
      Inputs/Outputs), so edits are never masked by a stale bundle. A CI agent without Node can still
      build the .NET package from a pre-built bundle that is newer than the sources — MSBuild then
      finds the output up to date and skips the npm steps entirely.
    -->
    <Target Name="BuildSignalRBundle"
            BeforeTargets="AssignTargetPaths"
            Inputs="@(SignalRAssetSource)"
            Outputs="$(SignalRBundlePath)">
        <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)/assets" Condition="!Exists('$(MSBuildProjectDirectory)/assets/node_modules')" />
        <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/assets" />
    </Target>

    <!--
      Embed the built bundle as a manifest resource. Runs unconditionally (after the optional
      rebuild) and before AssignTargetPaths so the dynamically added EmbeddedResource is picked up by
      the resource pipeline (hooking GenerateResource/CoreCompile is too late — the resource list is
      snapshotted earlier).
    -->
    <Target Name="EmbedSignalRBundle"
            BeforeTargets="AssignTargetPaths"
            DependsOnTargets="BuildSignalRBundle">
        <ItemGroup>
            <EmbeddedResource Include="$(SignalRBundlePath)" Condition="Exists('$(SignalRBundlePath)')">
                <LogicalName>Bielu.AspNetCore.AsyncApi.Scalar.SignalR.plugin.js</LogicalName>
            </EmbeddedResource>
        </ItemGroup>
    </Target>

</Project>
