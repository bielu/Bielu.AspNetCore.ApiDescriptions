<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Bielu.AspNetCore.AsyncApi</RootNamespace>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="ByteBard.AsyncAPI.NET" />
      <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
      <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Tests" />
      <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Versioning.Tests" />
      <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Overlay.Tests" />
      <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Merger" />
      <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Versioning" />
      <InternalsVisibleTo Include="Bielu.AspNetCore.AsyncApi.Cli" />
      <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Attributes\" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi.Attributes\Bielu.AspNetCore.AsyncApi.Attributes.csproj" />
      <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi.SourceGenerators\Bielu.AspNetCore.AsyncApi.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" AdditionalProperties="Configuration=Release" />
    </ItemGroup>
    <ItemGroup>
      <!-- Packaged analyzer is always built Release regardless of $(Configuration) here, so the
           path below can't drift out of sync with whichever config this project happens to build
           under (see CI failures where the two configs desynced and left bin/Release missing). -->
      <None Include="..\Bielu.AspNetCore.AsyncApi.SourceGenerators\bin\Release\netstandard2.0\Bielu.AspNetCore.AsyncApi.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

    <!-- CI packs with the NoBuild flag set, which skips the Build target (and with it, the
         ProjectReference's own build) entirely, so AdditionalProperties on the ProjectReference
         above never gets a chance to run. Build the analyzer explicitly right before packing so the
         None item above always has something to find, independent of whatever configuration (or
         build mode) produced this project's own output. -->
    <Target Name="BuildAnalyzerForPack" BeforeTargets="Pack;GenerateNuspec">
      <MSBuild Projects="..\Bielu.AspNetCore.AsyncApi.SourceGenerators\Bielu.AspNetCore.AsyncApi.SourceGenerators.csproj"
               Targets="Build"
               Properties="Configuration=Release;NoBuild=false" />
    </Target>
</Project>
