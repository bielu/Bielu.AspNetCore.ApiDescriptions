<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bielu.AspNetCore.AsyncApi.Scalar.Broker</RootNamespace>
        <Description>Interactive message-broker console for the Scalar API Reference in ASP.NET Core. Serves a Scalar bundle that publishes to and tails your Kafka/MQTT/AMQP channels through an opt-in server-side bridge, driven by your AsyncAPI bindings. Install a driver package (for example Bielu.AspNetCore.AsyncApi.Scalar.Broker.Kafka) to connect to a broker.</Description>
        <PackageTags>scalar;broker;kafka;mqtt;amqp;asyncapi;aspnetcore;api-reference</PackageTags>
        <DefaultItemExcludes>$(DefaultItemExcludes);assets/node_modules/**;assets/dist/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Scalar.AspNetCore" />
        <ProjectReference Include="..\Bielu.AspNetCore.AsyncApi.Scalar\Bielu.AspNetCore.AsyncApi.Scalar.csproj" />
    </ItemGroup>

    <!-- The interactive client lives in the assets/ npm package (@bielu/scalar-broker). The shared
         targets rebuild and embed the IIFE bundle incrementally; see ScalarPluginBundle.targets. -->
    <Import Project="..\Bielu.AspNetCore.AsyncApi.Scalar\build\ScalarPluginBundle.targets" />

</Project>
