{
  "name": "@bielu/scalar-broker",
  "version": "1.0.0",
  "description": "Interactive message-broker console plugin for the Scalar API Reference. Reads Kafka/MQTT/AMQP AsyncAPI bindings and publishes to and tails channels through an opt-in server-side bridge.",
  "license": "MIT",
  "author": "Arkadiusz Biel",
  "type": "module",
  "main": "./dist/plugin.js",
  "module": "./dist/plugin.mjs",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/plugin.js",
    "dist/plugin.mjs",
    "dist/types",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/plugin.mjs",
      "default": "./dist/plugin.js"
    }
  },
  "keywords": [
    "scalar",
    "broker",
    "kafka",
    "mqtt",
    "amqp",
    "asyncapi",
    "api-reference",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bielu/Bielu.AspNetCore.ApiDescriptions"
  },
  "scripts": {
    "build:core": "cd ../../Bielu.AspNetCore.AsyncApi.Scalar/assets && npm run build",
    "prebuild": "npm run build:core",
    "build": "vite build && vue-tsc -p tsconfig.json",
    "pretypecheck": "npm run build:core",
    "typecheck": "vue-tsc --noEmit",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@bielu/scalar-core": "file:../../Bielu.AspNetCore.AsyncApi.Scalar/assets",
    "@scalar/api-reference": "1.62.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vue-tsc": "^2.1.10"
  }
}
